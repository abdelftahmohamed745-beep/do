{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/server/**"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nine-vert-34.vercel.app"
        }
      ],
      "destination": "https://dory-system.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/clinic/:docId", "destination": "/api/clinic-render?docId=:docId" },
    { "source": "/lab/:labId", "destination": "/api/lab-render?labId=:labId" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

