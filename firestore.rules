rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ADMIN CHECK: Custom claims, Admins collection doc, or explicitly authorized Admin email with verification
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && (
          request.auth.token.email.lower() == 'bkay38757@gmail.com' ||
          request.auth.token.email.lower() == 'abdelftahmohamed745@gmail.com' || 
          request.auth.token.email.lower() == 'admin@dawry.app'
        ))
      );
    }

    // ORGANIZATION & CLINIC MEMBER ACCESS HELPERS
    function isOrgMember(orgId) {
      return isAuthenticated() && (
        request.auth.uid == orgId ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.organizationId == orgId &&
          get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.status == 'active'
        ) ||
        (
          exists(/databases/$(database)/documents/doctors/$(orgId)) &&
          get(/databases/$(database)/documents/doctors/$(orgId)).data.ownerId == request.auth.uid
        )
      );
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        request.auth.uid == orgId ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.organizationId == orgId &&
          get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role == 'OWNER' &&
          get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.status == 'active'
        ) ||
        (
          exists(/databases/$(database)/documents/doctors/$(orgId)) &&
          get(/databases/$(database)/documents/doctors/$(orgId)).data.ownerId == request.auth.uid
        )
      );
    }

    function isValidDoctorUpdate() {
      // Prevent client-side modification of administrative & billing fields
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'isAdmin', 
        'isActive', 
        'subscriptionStatus', 
        'subscriptionEndDate', 
        'subscriptionExpiresAt',
        'isLifetime',
        'subscriptionDurationType',
        'subscriptionDurationValue',
        'subscriptionStartedAt',
        'subscriptionLastModified',
        'subscriptionModifiedBy',
        'subscriptionNotes',
        'createdAt', 
        'ownerId'
      ]);
    }

    function isValidPatientCreate() {
      let data = request.resource.data;
      return data.name is string 
        && data.name.size() >= 2 
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() >= 8
        && data.phone.size() <= 20
        && data.sequenceNumber is number
        && data.sequenceNumber > 0
        && data.status == 'waiting'
        && (data.price == null || (data.price is number && data.price >= 0));
    }

    function isValidPatientUpdate() {
      // Prevent patient from updating server-controlled notification tracking flags
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'notificationSent',
        'notifiedForTwoTurns',
        'notifiedForOneTurn',
        'notifiedForTenMinutes',
        'sequenceNumber',
        'doctorId',
        'clinicId'
      ]);
    }

    function isValidRatingCreate() {
      let data = request.resource.data;
      return data.doctorId is string
        && data.patientRecordId is string
        && data.stars is number
        && data.stars >= 1
        && data.stars <= 5;
    }

    function isDoctorRatingStatsUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['ratingAverage', 'ratingCount'])
        && (request.resource.data.ratingAverage is number && request.resource.data.ratingAverage >= 0 && request.resource.data.ratingAverage <= 5)
        && (request.resource.data.ratingCount is number && request.resource.data.ratingCount >= 0);
    }

    // Doctors collection
    match /doctors/{doctorId} {
      // Public directory read allowed for all visitors/patients
      allow read: if true;
      
      // Creation allowed for authenticated self or admin
      allow create: if isOwner(doctorId) || isAdmin();

      // Updates: ONLY owner without protected fields OR admin
      allow update: if (isOwner(doctorId) && isValidDoctorUpdate()) || isAdmin();

      // Deletion: Restricted strictly to Admin (doctors cannot delete their account directly)
      allow delete: if isAdmin();

      // Isolated Patient Medical Files subcollection (Doctor / Org Member or Admin ONLY)
      match /patientFiles/{patientId} {
        allow read, write: if isOrgMember(doctorId) || isAdmin();
        match /{subcollection=**} {
          allow read, write: if isOrgMember(doctorId) || isAdmin();
        }
      }

      // Prescription Templates (Doctor / Org Member or Admin ONLY)
      match /templates/{templateId} {
        allow read, write: if isOrgMember(doctorId) || isOwner(doctorId) || isAdmin();
      }

      // Daily Clinic Operating Sessions & Archives (Doctor / Org Member or Admin ONLY)
      match /dailySessions/{sessionId} {
        allow read, write: if isOrgMember(doctorId) || isAdmin();
        match /{subcollection=**} {
          allow read, write: if isOrgMember(doctorId) || isAdmin();
        }
      }

      // AI Persistent Conversations (Doctor / Org Member or Admin ONLY)
      match /aiConversations/{conversationId} {
        allow read, write: if isOrgMember(doctorId) || isOwner(doctorId) || isAdmin();
        match /{subcollection=**} {
          allow read, write: if isOrgMember(doctorId) || isOwner(doctorId) || isAdmin();
        }
      }

      // Autonomous AI Tasks & Rules (Doctor / Org Member or Admin ONLY)
      match /aiTasks/{taskId} {
        allow read, write: if isOrgMember(doctorId) || isOwner(doctorId) || isAdmin();
      }

      // AI Audit Logs (Doctor / Org Member or Admin ONLY)
      match /aiAuditLogs/{logId} {
        allow read, write: if isOrgMember(doctorId) || isOwner(doctorId) || isAdmin();
      }
    }

    // Queues and Patients subcollection
    match /queues/{doctorId}/patients/{patientId} {
      // Allow single ticket lookup by ID for patient turn tracking;
      // Restrict collection listing strictly to clinic members & admins to prevent patient scraping
      allow get: if isOrgMember(doctorId) || isAdmin() || (resource.data.sequenceNumber is number);
      allow list: if isOrgMember(doctorId) || isAdmin();

      // Create: Validated ticket creation with required payload fields or by clinic staff/doctor/admin
      allow create: if isValidPatientCreate() || isOrgMember(doctorId) || isAdmin();

      // Update: Doctor owner, clinic member, or admin can update; or patient cancelling their ticket
      allow update: if (isOrgMember(doctorId) && isValidPatientUpdate()) 
        || isAdmin() 
        || (
          resource.data.phone == request.resource.data.phone && 
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt'])
        );

      // Delete: Clinic doctor owner/member or admin
      allow delete: if isOrgMember(doctorId) || isAdmin();
    }

    // Daily sequence counter for atomic queue numbers - protected from resets
    match /queues/{doctorId}/dailyCounters/{dateId} {
      allow read: if true;
      allow create: if isOrgMember(doctorId) || isAdmin() || (
        request.resource.data.lastSequenceNumber == 1 &&
        request.resource.data.date == dateId
      );
      allow update: if isOrgMember(doctorId) || isAdmin() || (
        request.resource.data.lastSequenceNumber == resource.data.lastSequenceNumber + 1 &&
        request.resource.data.date == dateId
      );
      allow delete: if isOrgMember(doctorId) || isAdmin();
    }

    // Clinic Members collection
    match /clinic_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isOrgOwner(request.resource.data.organizationId) 
        || isAdmin()
        || (
          isOwner(memberId) &&
          request.resource.data.role != 'OWNER' &&
          request.resource.data.status == 'active'
        );
      allow update: if isOrgOwner(resource.data.organizationId) || isAdmin() || (
        isOwner(memberId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'customPermissions', 'organizationId', 'status', 'invitedBy'])
      );
      allow delete: if isOrgOwner(resource.data.organizationId) || isAdmin();
    }

    // Clinic Invitations collection
    match /clinic_invitations/{invitationId} {
      // Allow reading invitations so invited user can view invitation details before accepting
      allow read: if true;

      // Creation allowed for Clinic Owner or Admin
      allow create: if (isOrgOwner(request.resource.data.organizationId) || isAdmin())
        && request.resource.data.role != 'OWNER'
        && request.resource.data.status == 'pending';

      // Updates allowed for Owner/Admin OR authenticated invited user accepting invitation matching email
      allow update: if isOrgOwner(resource.data.organizationId) || isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedByUid == request.auth.uid &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.customPermissions == resource.data.customPermissions &&
        (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.invitedEmail.lower())
      );

      // Deletion allowed for Clinic Owner or Admin
      allow delete: if isOrgOwner(resource.data.organizationId) || isAdmin();
    }

    // Organizations collection & subcollections
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create, update: if isOrgOwner(orgId);

      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgOwner(orgId) || isAdmin() || (
          isOwner(memberId) &&
          request.resource.data.role != 'OWNER' &&
          request.resource.data.status == 'active'
        );
        allow update: if isOrgOwner(orgId) || (
          isOwner(memberId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'customPermissions', 'organizationId', 'status', 'invitedBy'])
        );
        allow delete: if isOrgOwner(orgId);
      }

      match /audit_logs/{logId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if false;
      }

      // Services subcollection
      match /services/{serviceId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if isOrgMember(orgId);
        allow delete: if isOrgOwner(orgId) || isAdmin();
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if isOrgMember(orgId);
        allow delete: if isOrgOwner(orgId) || isAdmin();
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId);
      }
    }

    // Clinic Transactions collection (split payments, fees, receipts)
    match /clinic_transactions/{txId} {
      allow read: if (isAuthenticated() && resource.data.organizationId == request.auth.uid) || isOrgMember(resource.data.organizationId) || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.organizationId == request.auth.uid) || isOrgMember(request.resource.data.organizationId) || isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.organizationId == request.auth.uid) || isOrgMember(resource.data.organizationId) || isAdmin();
    }

    // User FCM Tokens collection
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User Notification Preferences
    match /users/{userId}/settings/notifications {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User In-App Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Email Verifications collection
    match /email_verifications/{docId} {
      allow read, create, update: if isAuthenticated() && (request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid) || isAdmin();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Ratings & Reviews collection
    match /ratings/{ratingId} {
      allow read: if true; // Public read for clinic reviews & averages
      allow create: if isValidRatingCreate();
      allow update, delete: if isAdmin();
    }

    // Follow Up Appointments collection
    match /followUpAppointments/{appointmentId} {
      // Secure read: clinic doctor owner, clinic members & admin can view full appointments
      allow read: if (isAuthenticated() && resource.data.doctorId == request.auth.uid) || isOrgMember(resource.data.doctorId) || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.doctorId == request.auth.uid) || isOrgMember(request.resource.data.doctorId) || isAdmin() || (
        request.resource.data.patientName is string &&
        request.resource.data.patientPhone is string &&
        request.resource.data.doctorId is string
      );
      // Updates allowed for doctor/staff OR patient updating status to confirmed/cancelled
      allow update: if (isAuthenticated() && resource.data.doctorId == request.auth.uid) || isOrgMember(resource.data.doctorId) || isAdmin() || (
        resource.data.patientPhone == request.resource.data.patientPhone &&
        request.resource.data.status in ['confirmed', 'cancelled'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isOwner(resource.data.doctorId) || isOrgMember(resource.data.doctorId) || isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update: if (isOwner(adminId) && request.auth.token.email != null && (request.auth.token.email.lower() == 'abdelftahmohamed745@gmail.com' || request.auth.token.email.lower() == 'admin@dawry.app')) || isAdmin();
      allow delete: if isAdmin();
    }

    // Subscription Logs collection
    match /subscription_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clinicId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Labs collection & subcollections
    function isLabMember(labId) {
      return isAuthenticated() && (
        request.auth.uid == labId ||
        isAdmin() ||
        exists(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid))
      );
    }

    function isLabOwnerOrManager(labId) {
      return isAuthenticated() && (
        request.auth.uid == labId ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)).data.role == 'OWNER' ||
            get(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)).data.role == 'MANAGER'
          )
        )
      );
    }

    function isLabReviewer(labId) {
      return isAuthenticated() && (
        request.auth.uid == labId ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)).data.role == 'OWNER' ||
            get(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)).data.role == 'MANAGER' ||
            get(/databases/$(database)/documents/labs/$(labId)/staff/$(request.auth.uid)).data.role == 'REVIEWER'
          )
        )
      );
    }

    match /labs/{labId} {
      allow read: if true; // Public read for public lab pages
      allow create: if isOwner(labId) || isAdmin();
      allow update: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
      allow delete: if isAdmin();

      match /catalog/{testId} {
        allow read: if true; // Public catalog view
        allow create, update, delete: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
      }

      match /orders/{orderId} {
        // Individual order lookup allowed for authorized staff/admin or the patient with their phone match; batch list restricted to lab members
        allow get: if isLabMember(labId) || isAdmin() || (
          isAuthenticated() && (
            resource.data.patientUserId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        );
        allow list: if isLabMember(labId) || isAdmin();
        // Public booking allowed for valid payload
        allow create: if request.resource.data.patientName is string
          && request.resource.data.patientName.size() >= 2
          && request.resource.data.patientPhone is string
          && request.resource.data.patientPhone.size() >= 8
          && request.resource.data.totalPrice is number
          && request.resource.data.totalPrice >= 0;
        // Updates allowed for lab staff member OR patient updating status to CANCELLED
        allow update: if isLabMember(labId) || (
          resource.data.patientPhone == request.resource.data.patientPhone &&
          request.resource.data.status == 'CANCELLED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt'])
        );
        allow delete: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
      }

      match /samples/{sampleId} {
        // Samples strictly internal to lab staff & admin
        allow get, list: if isLabMember(labId) || isAdmin();
        allow create, update, delete: if isLabMember(labId) || isAdmin();
      }

      match /results/{resultId} {
        // Patient views published result by ID; batch listing restricted to lab staff
        allow get: if resource.data.status == 'published' || isLabMember(labId) || isAdmin();
        allow list: if isLabMember(labId) || isAdmin();
        // Draft / initial entry allowed for lab staff
        allow create: if isLabMember(labId);
        // Direct publish requires Reviewer/Owner/Manager role
        allow update: if isLabMember(labId) && (
          request.resource.data.status != 'published' || isLabReviewer(labId)
        );
        allow delete: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
      }

      match /staff/{staffId} {
        allow read: if isLabMember(labId);
        allow write: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId) || (isAuthenticated() && request.auth.uid == staffId);
      }

      match /finances/{txId} {
        allow read, write: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
      }

      match /auditLogs/{logId} {
        allow read: if isOwner(labId) || isAdmin() || isLabOwnerOrManager(labId);
        allow create: if isLabMember(labId);
        allow update, delete: if false;
      }
    }

    // Admin Announcements & Notifications collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 5000
      );
      allow delete: if isAdmin();
    }

    // User preferences & cross-device state (e.g. read announcements)
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Unified Patients Identity & Profiles collection
    match /patients/{patientId} {
      // Prevent public listing of all patient profiles across the database
      allow list: if isAuthenticated() || isAdmin();
      // Allow single lookup for authenticated staff/admin or patient lookup of their own profile
      allow get: if isAuthenticated() || isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid == patientId));
      // Validated profile creation (e.g. during booking or registration)
      allow create: if (
        request.resource.data.name is string && 
        request.resource.data.name.size() >= 2 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8
      );
      // Updates restricted to authenticated staff/doctor/admin or patient updating their own record
      allow update: if isAuthenticated() || isAdmin() || (
        resource.data.phone == request.resource.data.phone &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'id', 'patientId'])
      );
      allow delete: if isAdmin();

      // Patient Prescriptions subcollection (Paper & Digital Rx)
      match /prescriptions/{prescriptionId} {
        allow read: if isAuthenticated() || isAdmin();
        allow create: if isAuthenticated() || isAdmin();
        allow update, delete: if isAuthenticated() || isAdmin();
      }
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
